# Aphelion node secrets.
#
# Copy to `.env` and fill in. Everything here is a credential: `.env` is
# gitignored, and nothing in this file belongs in aphelion.toml.

# Postgres connection string.
DATABASE_URL=postgres://aphelion:aphelion@localhost:5432/aphelion

# Stellar secret seed (S...) for the account that pays submission fees.
# Deliberately separate from the node's Ed25519 signing key: this one can be
# rotated or shared with a relayer without being able to sign a price.
APHELION_STELLAR_SECRET=

# Deployed contract ids. These override aphelion.toml when set, which is what
# makes one image usable across testnet and mainnet.
APHELION_REGISTRY_CONTRACT=
APHELION_AGGREGATOR_CONTRACT=

# Optional: CoinGecko Pro key, if the coingecko source is enabled.
# COINGECKO_API_KEY=

# Optional: poll a venue somewhere other than its public endpoint -- a cache or
# a regional proxy you run yourself. Unset means the built-in address; an empty
# value means the same, so leaving these here costs nothing.
# APHELION_SOURCE_URL_BINANCE=
# APHELION_SOURCE_URL_KRAKEN=
# APHELION_SOURCE_URL_COINBASE=

# Optional: the Stellar CLI to shell out to, if it is not `stellar` on PATH.
# APHELION_STELLAR_BIN=

# Logging. `APHELION_LOG_FORMAT=json` switches to structured output.
APHELION_LOG=info,aphelion_node=debug
# APHELION_LOG_FORMAT=json
