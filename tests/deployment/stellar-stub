#!/usr/bin/env bash
#
# A stand-in for the `stellar` CLI, in the shape `verify-deployment.sh` uses
# it: `contract invoke --id C... -- <function> [--arg value]`, with the reply
# as JSON on stdout.
#
# Answers come from the fixture named by $FIXTURE, an object keyed
# "<contract-id>.<function>" or, for a call that takes one argument,
# "<contract-id>.<function>.<value>" -- checked in that order, so a feed or a
# node can answer differently from its siblings without restating the rest. A
# key that is absent is a call the contract refused: non-zero exit, nothing on
# stdout, which is what the real CLI does with a failing simulation.

set -euo pipefail

[[ "${1:-}" == "contract" && "${2:-}" == "invoke" ]] || {
    echo "stellar-stub: only 'contract invoke' is understood: $*" >&2
    exit 64
}

# Everything before `--` is the CLI's own configuration, of which only --id
# matters; everything after it is the contract call.
id=""; split=0
for (( i = 1; i <= $#; i++ )); do
    [[ "${!i}" == "--id" ]] && { j=$(( i + 1 )); id="${!j}"; }
    [[ "${!i}" == "--" ]] && { split=$i; break; }
done
(( split )) || { echo "stellar-stub: no '--' in: $*" >&2; exit 64; }

fn_i=$(( split + 1 )); fn="${!fn_i}"
arg_i=$(( split + 3 )); arg=""; (( $# >= arg_i )) && arg="${!arg_i}"

for key in "$id.$fn${arg:+.$arg}" "$id.$fn"; do
    if jq -e --arg k "$key" 'has($k)' "$FIXTURE" >/dev/null; then
        jq -c --arg k "$key" '.[$k]' "$FIXTURE"
        exit 0
    fi
done

echo "stellar-stub: $id has no $fn${arg:+($arg)}" >&2
exit 1
